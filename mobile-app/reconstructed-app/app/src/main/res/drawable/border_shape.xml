<?xml version="1.0" encoding="utf-8"?>
<!--
  [신규 재구성]
  원문 근거: "병실 화면의 호실마다 침대의 네모난 빈 틀을 만드는 코드입니다.
  따로 만들어 디자인을 할 때 삽입하여 써야합니다." (최종보고서 ver1.5.0, Android 담당 팀원 개인보고서 동일 텍스트)
  정확한 stroke 두께/색상 hex는 문서에 없어 reconstructed approximation으로 처리.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <stroke
        android:width="1dp"
        android:color="@color/border_line" />
    <corners android:radius="4dp" />
</shape>
